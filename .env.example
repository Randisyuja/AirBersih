# ==========================================
# AirBersih / Water Pay Environment Variables
# ==========================================

# 1. Django Security Settings
# Generate a new random key with: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=django-insecure-replace-with-a-secure-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.50
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost,http://192.168.1.50

# 2. PostgreSQL Database Configuration
DB_NAME=airbersih_db
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_database_yang_kuat
DB_HOST=db
DB_PORT=5432

# 3. Web Server Runtime Options
WEB_PORT=8010
PROD_PORT=80
WEB_CONCURRENCY=2
RUN_MIGRATIONS=1
COLLECT_STATIC=1

# 4. Optional Development Tools (Hanya untuk docker-compose.yml dev)
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5055
DOCS_PORT=8011
