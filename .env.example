# ==========================================
# AirBersih / Water Pay Environment Variables
# ==========================================

# Django Settings
SECRET_KEY=django-insecure-replace-with-a-secure-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL Database Configuration
DB_NAME=airbersih_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Or unified DATABASE_URL (for Railway, Render, etc.)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/airbersih_db

# Container & Runtime Options
PORT=8000
WEB_CONCURRENCY=3
RUN_MIGRATIONS=1
COLLECT_STATIC=1

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
